# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# HTTPS-адрес, где опубликована папка webapp (GitHub Pages, Vercel и т. п.)
WEBAPP_URL=https://your-name.github.io/cafe-miniapp/webapp/

# Telegram id сотрудников, которым приходят заказы (через запятую)
ADMIN_IDS=123456789

# Прокси, если Telegram доступен только через VPN (по умолчанию берётся системный HTTPS_PROXY)
# PROXY=http://127.0.0.1:10809
